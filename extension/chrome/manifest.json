{
  "manifest_version": 3,
  "name": "Jex CAdES",
  "version": "0.1.4",
  "description": "Jex Native Messaging bridge for CAdES / GOST (cadesplugin-compatible).",
  "key": "",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Jex"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "nmcades_plugin_api.js",
        "jex_api.js",
        "page_hook.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}