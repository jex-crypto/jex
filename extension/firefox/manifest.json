{
  "manifest_version": 2,
  "name": "Jex CAdES",
  "version": "0.1.3",
  "description": "Jex Native Messaging bridge for CAdES / GOST (cadesplugin-compatible).",
  "browser_specific_settings": {
    "gecko": {
      "id": "jex@jex.local",
      "strict_min_version": "115.0"
    }
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Jex"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page_hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "nativeMessaging",
    "scripting",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    "nmcades_plugin_api.js",
    "jex_api.js",
    "page_hook.js"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
